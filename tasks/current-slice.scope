# Restore only from a fully captured immutable catalog snapshot after strict preflight.
# Authority: private restore kernel; no CLI, TUI, or public CatalogEntry API changes.
# Invariants: explicit absolute real home, no ambient HOME, all records/sources captured
# before mutation, exact file/directory bytes and modes, fatal preflight is zero-mutation.
# Deferred: opaque public CatalogEntry binding (BA1C), CLI restore (BC1), TUI restore (BC2).
version=2
slice_id=ba1b-immutable-restore-kernel
state=contract-frozen
max_total_files=2
max_production_files=1
max_changed_lines=380
ignore=tasks/pi-agent-integration-spec.md
allow=internal/backup/backup.go
allow=internal/backup/catalog_test.go
allow=tasks/slice-commit-ledger.tsv
test=internal/backup/catalog_test.go
