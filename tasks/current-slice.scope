# Reconcile the canonical runner/restore split before candidate integration.
# Authority: roadmap, active status, and a machine-checked split/accounting projection.
# No product code, branch integration, remote state, or release promotion is included.
version=2
slice_id=g3-split-roadmap-reconciliation
state=reviewed
max_total_files=3
max_production_files=1
max_changed_lines=360
ignore=tasks/pi-agent-integration-spec.md
allow=tasks/implementation-release-plan-2026-07-13.md
allow=tasks/todo.md
allow=tests/implementation-release-plan_test.sh
allow=tasks/slice-commit-ledger.tsv
test=tests/implementation-release-plan_test.sh
