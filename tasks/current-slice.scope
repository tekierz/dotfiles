# Synchronize the active todo control projection with committed G3A plan authority.
# Authority: todo-only milestones, live accounting, G2 integration block, and RG0 condition.
# The serial plan payload is already closed by G3A at 0182fe7.
version=2
slice_id=g3b-todo-control-sync
state=tests-red
max_total_files=2
max_production_files=1
max_changed_lines=160
ignore=tasks/pi-agent-integration-spec.md
allow=tasks/todo.md
allow=tests/implementation-release-plan_todo_test.sh
allow=tasks/slice-commit-ledger.tsv
test=tests/implementation-release-plan_todo_test.sh
