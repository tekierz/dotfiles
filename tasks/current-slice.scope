# Bind restore destinations to one real root and exact accepted parent namespace.
# Authority: opaque DirectoryState and RestoreSession parent materialization/rollback only.
# Invariants: exact existing ancestors, session-evidenced 0700 missing tails,
# sibling evidence reuse, reverse cleanup, parent drift precedence, no leaf mutation.
# Deferred: file/directory restore/remove leaves (BA1SF2), catalog kernel (BA1B2).
version=2
slice_id=ba1sf1-restore-parent-authority
state=verified
max_total_files=5
max_production_files=3
max_changed_lines=760
ignore=tasks/pi-agent-integration-spec.md
allow=internal/safefile/restore_session.go
allow=internal/safefile/restore_session_parent_unix.go
allow=internal/safefile/restore_session_unsupported.go
allow=internal/safefile/restore_session_parent_unix_test.go
allow=internal/safefile/unsupported_test.go
allow=tasks/slice-commit-ledger.tsv
test=internal/safefile/restore_session_parent_unix_test.go
test=internal/safefile/unsupported_test.go
