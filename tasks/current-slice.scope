# Add session-bound exact file restore and remove leaf mutations.
# Dependency: closed BA1SF1 restore parent authority at 351fb1c.
# Authority: immutable snapshot file extraction and exact Revision CAS only.
# Invariants: invalid source is rejected before parent creation; returned Revision is exact;
# rejected drift preserves identity; committed errors never roll back installed state.
# Deferred: directory leaves (BA1SF2D), catalog kernel (BA1B2).
version=2
