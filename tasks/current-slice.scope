# Own ordinary Darwin/Linux streaming groups through cleanup, readers, and sole reap.
# Authority: RunStreaming and RunExactStreaming same-UID lifecycle using RK1UO.
# Invariants: first abnormal cause, cleanup before sole Wait, stable cached Wait/Done,
# bounded escaped pipe holders, exclusive scan/undrained errors, idempotent Cancel.
# RunStreamingWithSudo fails closed before subprocess until RK1P.
# Deferred: privileged/setuid execution and deliberately escaped descendants beyond FD cleanup.
version=2
slice_id=rk1ul-ordinary-streaming-lifecycle
state=planned
max_total_files=5
max_production_files=3
max_changed_lines=800
ignore=tasks/pi-agent-integration-spec.md
allow=internal/runner/bash.go
allow=internal/runner/exact_streaming.go
allow=internal/runner/streaming_lifecycle.go
allow=internal/runner/exact_streaming_test.go
allow=internal/runner/streaming_lifecycle_test.go
allow=tasks/slice-commit-ledger.tsv
test=internal/runner/exact_streaming_test.go
test=internal/runner/streaming_lifecycle_test.go
