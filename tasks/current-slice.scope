# Observe Darwin/Linux child exit without consuming the exec.Cmd wait status.
# Authority: native no-reap exit observation only; no streaming adapter or signaling changes.
# Invariants: blocks until real exit, never reaps, Close releases observer resources,
# invalid/setup/native failures are explicit, and the sole later cmd.Wait gets exact status.
# Deferred: process-group lifecycle and bounded readers (RK1UL), privileged sudo (RK1P).
version=2
slice_id=rk1uo-native-exit-observer
state=tests-red
max_total_files=4
max_production_files=3
max_changed_lines=220
ignore=tasks/pi-agent-integration-spec.md
allow=internal/runner/exit_observer.go
allow=internal/runner/exit_observer_linux.go
allow=internal/runner/exit_observer_darwin.go
allow=internal/runner/exit_observer_unix_test.go
allow=tasks/slice-commit-ledger.tsv
test=internal/runner/exit_observer_unix_test.go
