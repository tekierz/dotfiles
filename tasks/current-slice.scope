# Synchronize active todo and workflow-policy truth with committed G3C plan authority.
# Authority: todo milestones, live accounting, G2 integration block, and RG0 condition.
# G3B remains stopped without ledger/candidate authority; G3C closed at b74c799.
version=2
slice_id=g3d-todo-policy-sync
state=verified
max_total_files=3
max_production_files=1
max_changed_lines=180
ignore=tasks/pi-agent-integration-spec.md
allow=tasks/todo.md
allow=tests/implementation-release-plan_todo_test.sh
allow=tests/check-slice-scope_test.sh
allow=tasks/slice-commit-ledger.tsv
test=tests/implementation-release-plan_todo_test.sh
test=tests/check-slice-scope_test.sh
