# Pre-G1 governance bootstrap: committed means the frozen payload landed;
# tests-red, review, verified evidence, and a normal ledger row do not exist.
version=1
slice_id=g0-plan-state-reset
state=committed
max_total_files=3
max_production_files=1
max_changed_lines=1000
exception=Governance-only audit and fixed catalog total 944 changed lines with no product code.
ignore=tasks/pi-agent-integration-spec.md
allow=tasks/release-audit-2026-07-13.md
allow=tasks/implementation-release-plan-2026-07-13.md
allow=tasks/todo.md
