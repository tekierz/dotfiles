# Reconcile the stopped combined restore-leaf slice as serialized file and directory leaves.
# Authority: plan-only dependency graph, budgets, Wave 1 schedule, accounting, and gates.
# The stale G3B control attempt has no ledger/candidate authority; control sync is deferred to G3D.
version=2
slice_id=g3c-restore-leaf-resplit
state=committed
max_total_files=2
max_production_files=1
max_changed_lines=220
ignore=tasks/pi-agent-integration-spec.md
allow=tasks/implementation-release-plan-2026-07-13.md
allow=tests/implementation-release-plan_test.sh
allow=tasks/slice-commit-ledger.tsv
test=tests/implementation-release-plan_test.sh
